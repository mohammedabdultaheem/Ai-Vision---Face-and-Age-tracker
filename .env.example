# AI VISION Enterprise Configuration

# Environment & Server
PROJECT_NAME="AI VISION - Enterprise Face Detection & Age Estimation"
VERSION="1.0.0"
DEBUG=False

# Security & Authentication
SECRET_KEY="ai-vision-enterprise-super-secret-key-change-in-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local zero-friction SQLite. In cloud/Docker: PostgreSQL
DATABASE_URL="sqlite:///./aivision.db"
# DATABASE_URL="postgresql://aivision_user:aivision_secure_pass_2026@localhost:5432/aivision"

# AI RAG Knowledge Assistant LLM Keys (Optional: local deterministic semantic fallback operates if omitted)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="gemini" # gemini, openai, local

# Frontend Public API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Privacy & Retention Posture
STORE_RAW_IMAGES=False # Strict privacy: zero persistent biometric retention
DEFAULT_RETENTION_DAYS=30

